# Server environment — copy to server/.env locally (never commit a real .env)
# Supabase pooler connection string; note the password's `#` must be URL-encoded as %23
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PORT=3001

# Stripe (TEST mode keys for local dev)
STRIPE_SECRET_KEY=sk_test_...
# Local dev: any random string — verify-extend.mjs self-signs webhook payloads with it.
# In production: the endpoint signing secret from the Stripe dashboard (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_localdev_<random-hex>
