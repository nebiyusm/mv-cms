# Server environment — copy to .env locally (never commit a real .env)
# Supabase pooler connection string; note the password's `#` must be URL-encoded as %23
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PORT=3001

# Frontend (Vite) — Supabase project URL + anon publishable key (safe for browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
